  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  PAUSED
}

enum DriftType {
  SUDDEN
  GRADUAL
  RECURRING
  INCREMENTAL
  CYCLICAL
}

enum DriftSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DriftStatus {
  DETECTED
  ACKNOWLEDGED
  ADAPTING
  ADAPTED
  IGNORED
  FALSE_POSITIVE
}

enum AutoMLType {
  NEURAL_ARCHITECTURE_SEARCH
  AUTOML_PIPELINE
  FEATURE_SELECTION
  HYPERPARAMETER_OPTIMIZATION
  MODEL_SELECTION
  ENSEMBLE_OPTIMIZATION
}

enum AutoMLStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  PAUSED
}

enum OnlineLearningType {
  INCREMENTAL
  BATCH_INCREMENTAL
  STREAMING
  MINI_BATCH
  STOCHASTIC
}

enum LearningSessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum TransferType {
  WEIGHTS
  FEATURES
  KNOWLEDGE
  POLICY
  ARCHITECTURE
  PARAMETERS
}

enum TransferStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum AdaptationType {
  LEARNING_RATE
  ARCHITECTURE
  THRESHOLD
  STRATEGY
  HYPERPARAMETER
  POLICY
}
